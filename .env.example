# ── Pick your provider ────────────────────────────────────────────────────
# Options: anthropic | openai | gemini | groq | deepseek | openrouter | local
PROVIDER_PRESET=anthropic

# ── Set the key for whichever provider you chose ──────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Local Ollama / LM Studio ignore the key value, but it must be non-empty:
OLLAMA_API_KEY=local

# ── Optional tuning ───────────────────────────────────────────────────────
ROUTE_THRESHOLD=0.50
MIN_ANSWER_CHARS=20
